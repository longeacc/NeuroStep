# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security (CHANGE in production) ---
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local skeleton (zero infra):
DATABASE_URL=sqlite:///./neurostep.db
# Production (docker-compose / managed PG):
# DATABASE_URL=postgresql+psycopg2://neurostep:neurostep@localhost:5432/neurostep

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=neurostep-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- CORS (Next.js frontend) ---
# CORS_ORIGINS=["http://localhost:3000"]

# --- First admin (created by seed) ---
FIRST_ADMIN_EMAIL=admin@neurostep.app
FIRST_ADMIN_PASSWORD=admin
